# Synthetic/local development only. Copy to .env and replace placeholders; never commit secrets.
# Oracle
ORACLE_PASSWORD=change-local-admin-password
DB_USER=clinevo
DB_PASSWORD=change-local-app-password
DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
DB_POOL_MAX=10
DB_POOL_MIN=2

# Spring Boot / API
PORT=8080
AI_SERVICE_URL=http://localhost:8000
AI_CONNECT_TIMEOUT_MS=5000
AI_READ_TIMEOUT_MS=120000
CORS_ORIGIN=http://localhost:4200
MAX_ATTACHMENT_BYTES=20971520
MAX_UPLOAD_SIZE=20MB
MAX_REQUEST_SIZE=25MB

# Authentication: demo keeps the candidate stack self-contained; oidc enables JWT RBAC.
AUTH_MODE=demo
CLINEVO_API_KEY=replace-with-long-random-local-key
OIDC_ISSUER_URI=https://idp.example.test/realms/clinevo
OIDC_JWK_SET_URI=https://idp.example.test/realms/clinevo/protocol/openid-connect/certs
OIDC_AUDIENCE=clinevo-inbox
OIDC_ROLES_CLAIM=roles
OIDC_PRINCIPAL_CLAIM=preferred_username

# Durable job processing
JOB_POLL_MS=1000
JOB_RECOVERY_MS=30000
JOB_MAX_ATTEMPTS=3
JOB_BATCH_SIZE=4
JOB_RETRY_BASE_SECONDS=5
JOB_LEASE_SECONDS=300

# Attachment security. Processing is fail-closed: disabling scanning prevents PDFs from reaching AI/OCR.
MALWARE_SCAN_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT_MS=3000
CLAMAV_READ_TIMEOUT_MS=30000
CLAMAV_CHUNK_BYTES=8192

# Original-document storage. Docker Compose uses filesystem mode on a persistent volume.
# retention-days=0 means indefinite retention; set a validated organizational policy before enabling purge.
DOCUMENT_STORAGE_MODE=filesystem
DOCUMENT_STORAGE_ROOT=/var/lib/clinevo/documents
DOCUMENT_RETENTION_DAYS=0
DOCUMENT_PURGE_POLL_MS=3600000
DOCUMENT_PURGE_BATCH_SIZE=50

# Test mailbox only
MAIL_POLL_SECONDS=60
MAIL_HOST=imap.example.test
MAIL_PORT=993
MAIL_USERNAME=test-inbox@example.test
MAIL_PASSWORD=replace-with-test-mailbox-password
MAIL_FOLDER=INBOX
MAIL_SSL=true

# Optional structured LLM endpoint. Leave URL/model empty for deterministic offline mode.
LLM_API_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
MAX_PDF_BYTES=20971520

# System One decision runtime
# laya = local/open-weight; jev = hosted TypeSafe API; auto = Laya -> Jev (when configured) -> deterministic fallback
DECISION_BACKEND=auto
# auto uses the owned model when a checkpoint exists, then Laya, then optional Jev, then deterministic fallback
DECISION_FALLBACK=true
LAYA_LOAD_MODE=lazy
LAYA_MAX_LOADED=2
LAYA_MODEL=
HF_HOME=/cache/huggingface

# Optional hosted Jev decision provider. Jev itself is not locally self-hosted.
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_API_KEY=
JEV_TIMEOUT_SECONDS=15
